  <apos IntegrityError x4> invoices=1 processes=1 tasks=1 inbox=['finance', 'workflow-preparacao-retirada'] outbox=[('ContractActivated.v1', 'PUBLISHED', 1, ''), ('ContractActivated.v1', 'PENDING', 0, '')]
[dispatch apos corrigir B] POST /api/v1/integration/outbox/dispatch -> 200 {} {"processed": 1, "failed": 0}
